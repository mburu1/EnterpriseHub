{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [ { "Name": "Console" } ]
  },

  "ConnectionStrings": {
    "Mssql": "Server=(localdb)\\MSSQLLocalDB;Database=EnterpriseHub;Trusted_Connection=True;TrustServerCertificate=True;",
    "Postgres": "Host=localhost;Port=5432;Username=postgres;Password=YOUR_PASSWORD;Database=enterprisehub_analytics",
    "MySql": "Server=localhost;Port=3306;Database=enterprisehub_billing;User=root;Password=YOUR_PASSWORD;",
    "Oracle": "User Id=system;Password=YOUR_PASSWORD;Data Source=localhost:1521/XEPDB1;",
    "Redis": "localhost:6379"
  },

  "Mongo": {
    "ConnectionString": "mongodb://localhost:27017/",
    "Database": "enterprisehub_docs"
  },

  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "User": "guest",
    "Password": "guest",
    "Exchange": "enterprisehub.events"
  },

  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "AuditTopic": "enterprisehub.audit-events"
  },

  "Email": {
    "SmtpHost": "smtp.sendgrid.net",
    "SmtpPort": 587,
    "SmtpUser": "apikey",
    "SmtpPassword": "YOUR_SENDGRID_API_KEY",
    "FromAddress": "no-reply@enterprisehub.dev"
  },

  "Jwt": {
    "Secret": "REPLACE_WITH_A_32_CHAR_MINIMUM_SECRET_FOR_LOCAL_DEV_ONLY",
    "Issuer": "EnterpriseHub",
    "Audience": "EnterpriseHub.Client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  }
}
