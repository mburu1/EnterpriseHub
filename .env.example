# Copy to .env and fill in real values for local docker-compose use.
# ASP.NET Core reads connection strings from appsettings.json / user-secrets in local dev;
# this file is for docker-compose service configuration and frontend API base URL.

# ---- API ----
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_HTTP_PORT=5001
ASPNETCORE_HTTPS_PORT=7001
JWT_SECRET=YOUR_JWT_SIGNING_KEY_MIN_32_CHARS
JWT_ISSUER=EnterpriseHub
JWT_AUDIENCE=EnterpriseHub.Client
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# ---- PostgreSQL (analytics / audit log) ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=enterprisehub_analytics
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_PASSWORD

# ---- MSSQL (primary store: tenants, users, projects, tasks) ----
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_DB=EnterpriseHub
MSSQL_USER=sa
MSSQL_PASSWORD=YOUR_PASSWORD
# Local dev without Docker can instead use: Server=(localdb)\MSSQLLocalDB;Database=EnterpriseHub;Trusted_Connection=True;

# ---- MySQL (billing / subscriptions) ----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=enterprisehub_billing
MYSQL_USER=root
MYSQL_PASSWORD=YOUR_PASSWORD

# ---- MongoDB (activity feeds / attachments) ----
MONGO_CONNECTION_STRING=mongodb://localhost:27017/
MONGO_DB=enterprisehub_docs

# ---- Redis (cache / sessions / rate limiting) ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- Oracle (reporting) ----
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=XEPDB1
ORACLE_USER=system
ORACLE_PASSWORD=YOUR_PASSWORD

# ---- RabbitMQ (internal event bus) ----
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ---- Kafka (audit event streaming) ----
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ---- Email (SMTP / SendGrid) ----
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=YOUR_SENDGRID_API_KEY
EMAIL_FROM=no-reply@enterprisehub.dev

# ---- Frontend ----
PUBLIC_API_BASE_URL=https://localhost:7001
FRONTEND_PORT=5173
